#!/usr/bin/env python3
"""agentaware — what every agent session on this machine is doing, and whether
there is room to start something heavy.

No daemon. Sessions report through Claude Code hooks into a registry in the
per-user runtime directory; liveness is derived from each session's own process
rather than a heartbeat, so a crashed window's record disappears on its own.

The admission gate is built on the number that actually decides whether this
machine OOMs: the memory pressure of the cgroup systemd-oomd is watching.

Python 3.8+, stdlib only.
"""
from __future__ import annotations

import argparse
import errno
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import time
from contextlib import contextmanager
from pathlib import Path

VERSION = "1.0.0"
SCHEMA = 1
MARKER = "agent-awareness"      # identifies our hooks inside settings.json

# One exit-code table for every subcommand.
RC_OK, RC_BUSY, RC_UNKNOWN, RC_ERROR = 0, 1, 2, 3


# ---------------------------------------------------------------- locations

def runtime_dir() -> Path:
    if os.environ.get("AGENTAWARE_DIR"):
        d = Path(os.environ["AGENTAWARE_DIR"])
    elif sys.platform == "darwin":
        try:
            base = Path(os.confstr("CS_DARWIN_USER_TEMP_DIR"))
        except (ValueError, AttributeError, TypeError):
            base = Path(os.environ.get("TMPDIR", "/tmp"))
        d = base / "agent-awareness"
    else:
        base = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
        if not os.path.isdir(base):
            base = os.environ.get("TMPDIR", "/tmp")
            d = Path(base) / f"agent-awareness-{os.getuid()}"
            d.mkdir(mode=0o700, parents=True, exist_ok=True)
            return d
        d = Path(base) / "agent-awareness"
    d.mkdir(mode=0o700, parents=True, exist_ok=True)
    return d


def state_dir() -> Path:
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    d = Path(base) / "agent-awareness"
    d.mkdir(mode=0o700, parents=True, exist_ok=True)
    return d


def boot_id() -> str:
    try:
        return Path("/proc/sys/kernel/random/boot_id").read_text().strip()
    except OSError:
        try:
            out = subprocess.run(["sysctl", "-n", "kern.boottime"], capture_output=True,
                                 text=True, timeout=5).stdout
            m = re.search(r"sec\s*=\s*(\d+)", out)
            if m:
                return "boottime-" + m.group(1)
        except Exception:
            pass
    return "unknown-boot"


# ----------------------------------------------------------------- liveness

UNKNOWN = "?"


def proc_field(pid: int, index: int) -> str | None:
    """A field of /proc/<pid>/stat, 1-based as in proc(5).

    Split after the LAST ') ': field 2 is the comm in parentheses and may itself
    contain spaces and ')', so splitting the whole line puts every later field at
    the wrong index. `awk '{print $22}'` returns 0 for such a process, and two
    unrelated processes then compare equal.
    """
    try:
        raw = Path(f"/proc/{pid}/stat").read_text()
    except OSError:
        return None
    try:
        return raw.rsplit(") ", 1)[1].split()[index - 3]
    except IndexError:
        return None


def starttime(pid: int) -> str | None:
    if os.path.isdir("/proc"):
        return proc_field(pid, 22)
    try:
        out = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)],
                             env={"LC_ALL": "C", "TZ": "UTC", "PATH": "/usr/bin:/bin"},
                             capture_output=True, text=True, timeout=5)
    except Exception:
        return UNKNOWN
    return out.stdout.strip() or None if out.returncode == 0 else None


def alive(rec: dict) -> bool:
    """True unless the reporting process is provably gone.

    'Cannot determine' must never mean 'dead' — dropping a live session's record
    is how a board tells you the machine is idle while five builds run.
    """
    if rec.get("boot_id") != boot_id():
        return False
    pid = rec.get("pid")
    if not isinstance(pid, int) or pid <= 0:
        return False
    cur = starttime(pid)
    if cur == UNKNOWN or rec.get("start") == UNKNOWN:
        return True
    return cur is not None and cur == rec.get("start")


def session_anchor() -> dict:
    """The long-lived process that IS this session.

    Every agent Bash call is a short-lived `bash -c` that exits, so $$ is useless
    as an identity. Walk up past the shell frames to the agent binary itself.
    """
    pid = os.getpid()
    transparent = {"bash", "sh", "zsh", "dash", "fish", "ksh", "flock", "timeout",
                   "env", "nohup", "setsid", "script", "sudo", "doas",
                   "python3", "python", "agentaware"}
    for _ in range(64):
        try:
            parent = int(proc_field(pid, 4) or 0)
        except (TypeError, ValueError):
            break
        if not parent or parent == 1:
            break
        try:
            comm = Path(f"/proc/{parent}/comm").read_text().strip()
        except OSError:
            break
        pid = parent
        if comm not in transparent:
            break
    try:
        comm = Path(f"/proc/{pid}/comm").read_text().strip()
    except OSError:
        comm = "unknown"
    return {"pid": pid, "start": starttime(pid), "comm": comm, "boot_id": boot_id()}


# ---------------------------------------------------------------- resources

def _psi(path: str) -> dict:
    """Parse a pressure-stall file into {'some': {...}, 'full': {...}}.

    PSI beats load average here: load average counts uninterruptible sleep, so a
    box thrashing on swap and a box compiling happily can report the same number.
    """
    out: dict = {}
    try:
        for line in Path(path).read_text().splitlines():
            parts = line.split()
            if not parts:
                continue
            out[parts[0]] = {k: float(v) for k, v in
                             (p.split("=", 1) for p in parts[1:]) if k != "total"}
    except (OSError, ValueError):
        pass
    return out


def user_cgroup() -> Path | None:
    """The cgroup systemd-oomd actually watches for this user's session."""
    p = Path(f"/sys/fs/cgroup/user.slice/user-{os.getuid()}.slice/"
             f"user@{os.getuid()}.service")
    return p if p.is_dir() else None


def oomd_limits() -> dict:
    """What will kill us, and at what threshold.

    systemd-oomd kills the leaf cgroup reclaiming hardest once its memory
    pressure stays above a limit for a duration. Reading that limit rather than
    inventing one is the difference between a gate that predicts an OOM kill and
    a gate with a number somebody liked.
    """
    lim = {"swap_pct": 90.0, "pressure_pct": 60.0, "duration": "20s", "source": "default"}
    if not shutil.which("oomctl"):
        return lim
    try:
        out = subprocess.run(["oomctl"], capture_output=True, text=True, timeout=10).stdout
    except Exception:
        return lim
    m = re.search(r"Swap Used Limit:\s*([\d.]+)%", out)
    if m:
        lim["swap_pct"] = float(m.group(1))
    m = re.search(r"Default Memory Pressure Limit:\s*([\d.]+)%", out)
    if m:
        lim["pressure_pct"] = float(m.group(1))
    m = re.search(r"Default Memory Pressure Duration:\s*(\S+)", out)
    if m:
        lim["duration"] = m.group(1)
    # A per-cgroup limit overrides the default for the slice we live in.
    mine = f"/user.slice/user-{os.getuid()}.slice/user@{os.getuid()}.service"
    m = re.search(re.escape(mine) + r"\s*\n\s*Memory Pressure Limit:\s*([\d.]+)%", out)
    if m:
        lim["pressure_pct"] = float(m.group(1))
        lim["source"] = "oomctl (this user's slice)"
    elif lim["source"] == "default":
        lim["source"] = "oomctl (system default)"
    return lim


def _meminfo() -> dict:
    info = {}
    try:
        for line in Path("/proc/meminfo").read_text().splitlines():
            k, _, v = line.partition(":")
            info[k] = int(v.split()[0]) * 1024      # kB -> bytes
    except (OSError, ValueError, IndexError):
        pass
    return info


def snapshot() -> dict:
    """Everything the gate reasons about, in one read."""
    mi = _meminfo()
    cg = user_cgroup()
    lim = oomd_limits()
    total = mi.get("MemTotal", 0)
    avail = mi.get("MemAvailable", 0)
    sw_total = mi.get("SwapTotal", 0)
    sw_free = mi.get("SwapFree", 0)
    sess_psi = _psi(str(cg / "memory.pressure")) if cg else {}
    snap = {
        "mem_total": total,
        "mem_available": avail,
        "mem_available_pct": round(100.0 * avail / total, 1) if total else 0.0,
        "swap_used_pct": round(100.0 * (sw_total - sw_free) / sw_total, 1) if sw_total else 0.0,
        # 'full' = every task stalled. For memory that is the number oomd acts on.
        "mem_pressure": (sess_psi.get("full") or {}).get("avg10", 0.0),
        "mem_pressure_some": (sess_psi.get("some") or {}).get("avg10", 0.0),
        "cpu_pressure": (_psi("/proc/pressure/cpu").get("some") or {}).get("avg10", 0.0),
        "io_pressure": (_psi("/proc/pressure/io").get("full") or {}).get("avg10", 0.0),
        "cpus": os.cpu_count() or 1,
        "oomd": lim,
        "pressure_source": str(cg / "memory.pressure") if cg else "unavailable",
    }
    if cg:
        try:
            snap["session_mem"] = int((cg / "memory.current").read_text().strip())
        except (OSError, ValueError):
            pass
        try:
            ev = dict(l.split() for l in (cg / "memory.events").read_text().splitlines())
            snap["oom_kills"] = int(ev.get("oom_kill", 0))
        except (OSError, ValueError):
            pass
    return snap


# A class says how heavy the work is. The reservation is what must be free
# BEFORE it starts, because a build admitted now allocates for the next minute.
CLASSES = {
    "render":  {"mem": 4 * 2**30, "slots": 1, "desc": "video/3D render, encode"},
    "build":   {"mem": 2 * 2**30, "slots": 0, "desc": "compile, bundle, package"},
    "test":    {"mem": 1 * 2**30, "slots": 2, "desc": "test suite, emulator-free"},
    "install": {"mem": 1 * 2**30, "slots": 2, "desc": "dependency resolution"},
    "light":   {"mem": 0,         "slots": 0, "desc": "anything not worth gating"},
}


def class_spec(name: str) -> dict:
    spec = dict(CLASSES.get(name) or CLASSES["light"])
    if spec["slots"] == 0:                       # 0 means "derive from the machine"
        spec["slots"] = max(1, (os.cpu_count() or 4) // 4)
    learned = learned_peak(name)
    if learned:
        spec["mem"] = max(spec["mem"], learned)
        spec["learned"] = True
    return spec


def learned_peak(name: str) -> int:
    """The largest memory peak actually observed for this class on this machine.

    A declared default is a guess about someone else's hardware. A measured peak
    is this machine telling you what the work really costs.
    """
    try:
        d = json.loads((state_dir() / "peaks.json").read_text())
        return int(d.get(name, {}).get("peak", 0))
    except (OSError, ValueError, TypeError):
        return 0


def record_peak(name: str, peak: int) -> None:
    p = state_dir() / "peaks.json"
    try:
        d = json.loads(p.read_text())
    except (OSError, ValueError):
        d = {}
    cur = d.get(name, {})
    if peak > int(cur.get("peak", 0)):
        d[name] = {"peak": peak, "at": time.time(), "runs": int(cur.get("runs", 0)) + 1}
    else:
        d[name] = {**cur, "runs": int(cur.get("runs", 0)) + 1}
    tmp = p.with_suffix(f".tmp.{os.getpid()}")
    tmp.write_text(json.dumps(d, indent=1, sort_keys=True))
    os.replace(tmp, p)


# ----------------------------------------------------------------- registry

@contextmanager
def registry(wait: float = 15.0):
    """Exclusive access to the shared state.

    The flock is taken on a file that is created once and never renamed or
    unlinked; the data is a separate file replaced by rename. Locking a file you
    then rename over gives every later arrival a lock on a fresh inode and
    silently destroys mutual exclusion — which for an admission gate means five
    sessions all being told they may start.
    """
    d = runtime_dir()
    lock_path, data_path = d / "registry.lock", d / "registry.json"
    fd = os.open(lock_path, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o600)
    deadline = time.monotonic() + wait
    try:
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError as e:
                if e.errno not in (errno.EWOULDBLOCK, errno.EACCES):
                    raise
                if time.monotonic() >= deadline:
                    raise SystemExit("agentaware: registry busy; retry")
                time.sleep(0.05)
        if os.stat(lock_path).st_ino != os.fstat(fd).st_ino:
            raise SystemExit("agentaware: the lock file was replaced underneath us; retry")
        try:
            data = json.loads(data_path.read_text())
            if data.get("schema") != SCHEMA:
                data = {}
        except (OSError, ValueError):
            data = {}
        data.setdefault("schema", SCHEMA)
        data.setdefault("sessions", {})
        data.setdefault("slots", {})
        st = {"data": data, "dirty": False}
        yield st
        if st["dirty"]:
            tmp = data_path.with_suffix(f".tmp.{os.getpid()}")
            tmp.write_text(json.dumps(data, indent=1, sort_keys=True))
            os.replace(tmp, data_path)
    finally:
        os.close(fd)


def prune(data: dict) -> int:
    """Drop records whose process is gone. Runs inside every transaction, so a
    crashed window frees its slot without anyone running a cleanup command."""
    n = 0
    for key in [k for k, v in data["sessions"].items() if not alive(v)]:
        del data["sessions"][key]
        n += 1
    for key in [k for k, v in data["slots"].items() if not alive(v)]:
        del data["slots"][key]
        n += 1
    return n


# --------------------------------------------------------------------- gate

def decide(data: dict, cls: str, snap: dict) -> tuple[bool, str]:
    """May work of this class start right now? Decided INSIDE the lock.

    A gate that samples the machine and then returns is TOCTOU by construction:
    five sessions read an idle box in the same second and all five start. The
    admission is therefore a *reservation* recorded under the same lock that
    read the state, so the second caller sees the first one's claim even though
    the first has not allocated a byte yet.
    """
    spec = class_spec(cls)
    if spec["mem"] == 0:
        return True, "unmetered class"

    lim = snap["oomd"]
    held = [v for v in data["slots"].values() if v.get("class") == cls]
    if len(held) >= spec["slots"]:
        who = ", ".join(sorted({v.get("repo", "?") for v in held}))
        return False, (f"{len(held)}/{spec['slots']} {cls} slots in use ({who})")

    # Reservations of everything already admitted but not yet finished.
    reserved = sum(class_spec(v.get("class", "light"))["mem"]
                   for v in data["slots"].values())
    free_after = snap["mem_available"] - reserved - spec["mem"]
    if free_after < 0:
        return False, (f"needs {gb(spec['mem'])} and only {gb(snap['mem_available'])} is "
                       f"available with {gb(reserved)} already reserved")

    # The pressure the OOM killer is actually watching. Gate well under its
    # limit: oomd acts after the limit is sustained for its duration, so being
    # at the limit already means something is about to be killed.
    ceiling = lim["pressure_pct"] / 2.0
    if snap["mem_pressure"] >= ceiling:
        return False, (f"memory pressure {snap['mem_pressure']:.1f}% is at or past "
                       f"half of oomd's {lim['pressure_pct']:.0f}% kill threshold")
    if snap["swap_used_pct"] >= lim["swap_pct"] * 0.8:
        return False, (f"swap {snap['swap_used_pct']:.0f}% used, near oomd's "
                       f"{lim['swap_pct']:.0f}% limit")
    return True, "ok"


def gb(n: float) -> str:
    return f"{n / 2**30:.1f}G"


def take_slot(data: dict, cls: str, why: str, session: dict) -> str:
    """A slot is held by the RUNNER process, not by the session.

    Keying liveness to the session would mean a `kill -9` of the runner leaves
    the slot held for as long as the agent window stays open — the queue then
    blocks on work that stopped minutes ago. The runner is the process that
    actually holds the memory, so it is the one whose death frees the slot.
    """
    me = os.getpid()
    key = f"{me}:{int(time.time() * 1000) % 100000}"
    data["slots"][key] = {
        "pid": me, "start": starttime(me), "boot_id": boot_id(),
        "session_pid": session.get("pid"), "comm": "agentaware",
        "class": cls, "why": why[:200], "repo": repo_name(), "since": time.time(),
    }
    return key


def repo_name() -> str:
    cwd = os.getcwd()
    try:
        top = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=cwd,
                             capture_output=True, text=True, timeout=5)
        if top.returncode == 0 and top.stdout.strip():
            return os.path.basename(top.stdout.strip())
    except Exception:
        pass
    return os.path.basename(cwd) or cwd


# ------------------------------------------------------------- classification

# Ordered: the first pattern that matches wins, so the expensive classes are
# checked before the generic ones.
_PATTERNS = [
    ("render", r"\b(ffmpeg|handbrake(cli)?|blender|nuke|resolve|davinci|"
               r"melt|kdenlive_render|x264|x265|svt-av1|nvenc)\b"),
    ("build",  r"\b(make|ninja|cmake|bazel|buck2?|cargo\s+(build|install)|"
               r"go\s+build|mvn|gradle(w)?|xcodebuild|msbuild|dotnet\s+build|"
               r"swift\s+build|webpack|vite\s+build|rollup|esbuild|tsc|"
               r"docker\s+(build|buildx)|nix\s+build|yarn\s+build|pnpm\s+build)\b"),
    ("test",   r"\b(pytest|jest|vitest|mocha|go\s+test|cargo\s+test|"
               r"gradlew?\s+test|ctest|rspec|phpunit|tox|nox)\b"),
    ("install", r"\b(apt|apt-get|dnf|yum|pacman|brew|"
                r"npm\s+(i|install|ci)|yarn\s+install|pnpm\s+install|"
                r"pip\s+install|pip3\s+install|cargo\s+fetch|go\s+mod\s+download)\b"),
]


def classify(command: str) -> tuple[str, float]:
    """Guess what a shell command is going to cost. Returns (class, confidence).

    This is a heuristic and it is wrong in knowable ways: a wrapper script named
    ./deploy that runs a build, a make target that only runs tests, the word
    'build' inside a heredoc, an ssh that compiles on another machine entirely.
    So it is only ever used to *suggest* a class — it never silently gates work,
    and `run --class` always wins over the guess.
    """
    if not command:
        return "light", 0.0
    head = command.split("\n", 1)[0][:600]
    # Work sent elsewhere does not consume this machine.
    if re.match(r"^\s*(ssh|scp|rsync\s+.*:)\b", head):
        return "light", 0.4
    for name, pat in _PATTERNS:
        if re.search(pat, head, re.I):
            # A wrapper hides its real cost; say so with lower confidence.
            conf = 0.5 if re.search(r"^\s*(\./|bash\s+|sh\s+)", head) else 0.85
            return name, conf
    if re.search(r"^\s*(\./|bash\s+\S+\.sh|sh\s+\S+\.sh|npm\s+run|"
                 r"yarn\s+\S+|pnpm\s+run|just\s|task\s)", head, re.I):
        return "unknown-wrapper", 0.2
    return "light", 0.6


_SECRET = re.compile(
    r"(?i)\b(?:--?(?:password|passwd|token|secret|api[-_]?key|auth)"
    r"[=\s]\S+|(?:AKIA|ghp_|gho_|github_pat_|sk-|xox[abprs]-)[A-Za-z0-9_\-]{8,})")


def redact(command: str) -> str:
    """The board is visible to every session and gets written to a log.

    Anything that looks like a credential is removed before it is recorded —
    enforced here rather than left to whoever writes the command.
    """
    s = _SECRET.sub("<redacted>", command)
    s = re.sub(r"(?i)(https?://)[^\s/@]+:[^\s/@]+@", r"\1<redacted>@", s)
    return s.split("\n", 1)[0][:160]


# -------------------------------------------------------------------- output

def _age(ts: float) -> str:
    d = max(0, int(time.time() - ts))
    if d < 60:
        return f"{d}s"
    if d < 3600:
        return f"{d // 60}m"
    return f"{d // 3600}h{(d % 3600) // 60:02d}"


def cmd_board(args) -> int:
    with registry() as st:
        data = st["data"]
        st["dirty"] = bool(prune(data))
        sessions = dict(data["sessions"])
        slots = dict(data["slots"])
    snap = snapshot()
    if args.json:
        print(json.dumps({"machine": snap, "sessions": sessions, "slots": slots}, indent=1))
        return RC_OK

    lim = snap["oomd"]
    head = (f"{gb(snap['mem_available'])} available of {gb(snap['mem_total'])}"
            f"  ·  mem pressure {snap['mem_pressure']:.1f}%"
            f" (oomd kills at {lim['pressure_pct']:.0f}% for {lim['duration']})"
            f"  ·  swap {snap['swap_used_pct']:.0f}%"
            f"  ·  cpu {snap['cpu_pressure']:.0f}%")
    print(head)
    if snap.get("oom_kills"):
        print(f"  {snap['oom_kills']} OOM kill(s) in this session since boot")
    print()

    if not sessions:
        print("no sessions reporting — install the hooks with: agentaware install-hooks")
    else:
        print(f"{'SESSION':<10} {'REPO':<20} {'DOING':<12} {'FOR':<6} WHAT")
        for k, v in sorted(sessions.items(), key=lambda x: x[1].get("since", 0)):
            print(f"{k[:8]:<10} {v.get('repo','?')[:20]:<20} "
                  f"{v.get('activity','?')[:12]:<12} {_age(v.get('since', 0)):<6} "
                  f"{v.get('detail','')[:60]}")
    print()
    if slots:
        print("HOLDING A SLOT")
        for v in slots.values():
            print(f"  {v['class']:<9} {v.get('repo','?'):<20} {_age(v['since']):<6} "
                  f"{v.get('why','')[:50]}")
    else:
        print("no metered work running")

    print()
    verdicts = []
    with registry() as st:
        for cls in ("render", "build", "test"):
            ok, why = decide(st["data"], cls, snap)
            verdicts.append(f"  {'YES' if ok else 'NO ':<4} {cls:<8} {'' if ok else why}")
    print("CAN I START ONE NOW?")
    print("\n".join(verdicts))
    return RC_OK


def cmd_gate(args) -> int:
    """One line, one exit code: may I start this now?"""
    snap = snapshot()
    with registry() as st:
        st["dirty"] = bool(prune(st["data"]))
        ok, why = decide(st["data"], args.klass, snap)
    if ok:
        print(f"YES  {args.klass}: {gb(snap['mem_available'])} available, "
              f"pressure {snap['mem_pressure']:.1f}%")
        return RC_OK
    print(f"WAIT {args.klass}: {why}"
          f"  ->  agentaware run --class {args.klass} -- <your command>")
    return RC_BUSY


# ---------------------------------------------------------------------- run

def cmd_run(args) -> int:
    """Wait for room, then run the command holding a slot for its whole life.

    The slot is released in a finally block, and the record is keyed to this
    process — so a kill -9, a crashed window, or an interrupted agent turn frees
    it on the next transaction rather than blocking the queue forever.
    """
    if not args.cmd:
        raise SystemExit("agentaware: nothing to run after --")
    me = session_anchor()
    cls = args.klass
    why = redact(" ".join(args.cmd))
    deadline = time.monotonic() + args.timeout
    key = None
    waited = 0.0
    attempt = 0

    while True:
        attempt += 1
        snap = snapshot()
        with registry() as st:
            data = st["data"]
            prune(data)
            ok, reason = decide(data, cls, snap)
            if ok:
                key = take_slot(data, cls, why, me)
                st["dirty"] = True
            else:
                st["dirty"] = True
        if ok:
            break
        if time.monotonic() >= deadline:
            print(f"agentaware: gave up after {int(waited)}s waiting for a {cls} slot: "
                  f"{reason}", file=sys.stderr)
            return RC_BUSY
        if attempt == 1 or attempt % 6 == 0:
            print(f"agentaware: waiting for a {cls} slot — {reason}", file=sys.stderr)
        # Jitter, or every waiter wakes together and they all lose together.
        nap = min(15.0, 2.0 * attempt) * (0.6 + (os.getpid() % 80) / 100.0)
        time.sleep(nap)
        waited += nap

    audit("admit", f"{cls} after {int(waited)}s: {why}")
    started = time.time()
    peak_before = _cg_peak()
    try:
        rc = subprocess.call(args.cmd)
    except KeyboardInterrupt:
        rc = 130
    except FileNotFoundError:
        print(f"agentaware: no such command: {args.cmd[0]}", file=sys.stderr)
        rc = 127
    finally:
        with registry() as st:
            st["data"]["slots"].pop(key, None)
            st["dirty"] = True
        peak = _cg_peak()
        if peak and peak_before is not None and peak > peak_before:
            record_peak(cls, peak - peak_before)
        audit("release", f"{cls} rc={rc} after {int(time.time() - started)}s")
    return rc


def _cg_peak() -> int | None:
    cg = user_cgroup()
    if not cg:
        return None
    try:
        return int((cg / "memory.peak").read_text().strip())
    except (OSError, ValueError):
        return None


def audit(action: str, detail: str) -> None:
    """One line, one write(2), on real disk.

    The registry lives in tmpfs and is meant to vanish at boot; the history must
    not, or 'what was running when it died at 4am' is unanswerable. A single
    write to a regular file is serialised under the inode lock, which is what
    makes concurrent appends from several sessions safe.
    """
    rec = {"iso": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "action": action,
           "detail": detail[:400], "pid": os.getpid(), "host": os.uname().nodename}
    line = (json.dumps(rec, sort_keys=True) + "\n").encode()[:2048]
    if not line.endswith(b"\n"):
        line = line[:-1] + b"\n"
    try:
        fd = os.open(state_dir() / "history.jsonl",
                     os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_CLOEXEC, 0o600)
        try:
            os.write(fd, line)
        finally:
            os.close(fd)
    except OSError:
        pass


# -------------------------------------------------------------------- hooks

_EVENT_ACTIVITY = {
    "SessionStart": "starting",
    "UserPromptSubmit": "thinking",
    "PreToolUse": "working",
    "PostToolUse": "working",
    "Stop": "idle",
    # A session killed mid-turn never fires Stop. Without SessionEnd its record
    # says 'working' until the process dies and prune notices — which is correct
    # but slow, and on the board a stale 'working' reads as a real build.
    "SessionEnd": "gone",
}


def cmd_hook(args) -> int:
    """Hook entry point. Fails open, always: a hook that breaks a turn is a hook
    the user removes within the hour, and then nothing is coordinated at all."""
    try:
        raw = sys.stdin.read() if not sys.stdin.isatty() else ""
        payload = json.loads(raw) if raw.strip() else {}
    except ValueError:
        payload = {}
    try:
        return _hook(args, payload)
    except Exception as e:                                   # noqa: BLE001
        print(f"# agent-awareness hook error (ignored): {e}", file=sys.stderr)
        return 0


def _hook(args, payload: dict) -> int:
    event = args.event
    me = session_anchor()
    sid = payload.get("session_id")
    cwd = payload.get("cwd") or os.getcwd()
    if not sid:
        # No session id means we cannot correlate this event with anything, and
        # a record we cannot correlate is a row on the board that never updates
        # and never clears. Failing open means not breaking the turn — it does
        # not mean inventing state. The banner is still worth printing.
        if event == "SessionStart":
            print(_session_start_banner(), end="")
        return 0
    activity = _EVENT_ACTIVITY.get(event, "working")
    detail = ""
    cls = "light"

    if event == "PreToolUse":
        tool = payload.get("tool_name", "")
        ti = payload.get("tool_input") or {}
        if tool == "Bash":
            command = ti.get("command", "")
            cls, conf = classify(command)
            detail = redact(command)
            activity = cls if cls not in ("light", "unknown-wrapper") else "working"
        elif tool in ("Edit", "Write", "NotebookEdit"):
            activity, detail = "editing", os.path.basename(str(ti.get("file_path", "")))
        elif tool in ("Read", "Grep", "Glob"):
            activity, detail = "reading", os.path.basename(str(ti.get("file_path", "")))
        else:
            activity, detail = "working", tool

    if event == "SessionStart":
        print(_session_start_banner(), end="")

    with registry() as st:
        data = st["data"]
        prune(data)
        if activity == "gone":
            data["sessions"].pop(sid, None)
        else:
            old = data["sessions"].get(sid, {})
            data["sessions"][sid] = {
                **me, "repo": os.path.basename(cwd) or cwd, "cwd": cwd,
                "activity": activity, "detail": detail, "class": cls,
                "since": time.time() if old.get("activity") != activity
                         else old.get("since", time.time()),
                "last_seen": time.time(),
            }
        st["dirty"] = True
    return 0


def _session_start_banner() -> str:
    """What every session is told at startup. Short, or it is skimmed."""
    snap = snapshot()
    with registry() as st:
        prune(st["data"])
        st["dirty"] = True
        others = len(st["data"]["sessions"])
        busy = [f"{v['class']}({v.get('repo','?')})" for v in st["data"]["slots"].values()]
    bits = [f"agent-awareness: {gb(snap['mem_available'])} of "
            f"{gb(snap['mem_total'])} free, memory pressure "
            f"{snap['mem_pressure']:.1f}% (oomd kills at "
            f"{snap['oomd']['pressure_pct']:.0f}%), {others} other session(s) reporting."]
    if busy:
        bits.append("Running now: " + ", ".join(busy) + ".")
    bits.append("Before any build, render, test or install, run it through "
                "`agentaware run --class <build|render|test|install> -- <cmd>` so it "
                "waits for room instead of racing the other windows. `agentaware board` "
                "shows who is doing what.")
    return " ".join(bits) + "\n"


# ----------------------------------------------------------- hook installation

HOOK_EVENTS = ["SessionStart", "UserPromptSubmit", "PreToolUse",
               "PostToolUse", "Stop", "SessionEnd"]


def settings_path() -> Path:
    return Path(os.environ.get("AGENTAWARE_SETTINGS")
                or os.path.expanduser("~/.claude/settings.json"))


def _our_command(event: str) -> str:
    exe = os.path.abspath(sys.argv[0])
    # The marker is what lets uninstall find exactly our hooks and nothing else.
    return f'"{exe}" hook {event}  # {MARKER}'


def _is_ours(entry: dict) -> bool:
    return MARKER in json.dumps(entry)


def cmd_install_hooks(args) -> int:
    p = settings_path()
    try:
        doc = json.loads(p.read_text()) if p.exists() else {}
    except ValueError as e:
        print(f"agentaware: {p} is not valid JSON ({e}).\n"
              "  Refusing to touch it — fix or move it first. Nothing was changed.",
              file=sys.stderr)
        return RC_ERROR
    if not isinstance(doc, dict):
        print(f"agentaware: {p} is not a JSON object; refusing to touch it",
              file=sys.stderr)
        return RC_ERROR

    hooks = doc.setdefault("hooks", {})
    added, refreshed = [], []
    for event in HOOK_EVENTS:
        groups = hooks.setdefault(event, [])
        if not isinstance(groups, list):
            print(f"agentaware: hooks.{event} is not a list; skipping it",
                  file=sys.stderr)
            continue
        # Replace only our own entry. Everyone else's hooks are left exactly
        # as they are — this file already carries other tools' hooks, and
        # rewriting it wholesale is how you silently break someone's setup.
        mine = [g for g in groups if _is_ours(g)]
        for g in mine:
            groups.remove(g)
        entry = {"hooks": [{"type": "command", "command": _our_command(event),
                            "timeout": 5}]}
        if event == "PreToolUse":
            entry["matcher"] = "Bash|Edit|Write|Read|Grep|Glob|NotebookEdit"
        groups.append(entry)
        (refreshed if mine else added).append(event)

    if args.dry_run:
        print(json.dumps(doc, indent=1))
        print(f"\n(dry run: would add {added or 'nothing'}, "
              f"refresh {refreshed or 'nothing'})", file=sys.stderr)
        return RC_OK

    if p.exists():
        backup = p.with_suffix(f".json.bak-{time.strftime('%Y%m%d-%H%M%S')}")
        shutil.copy2(p, backup)
        print(f"backed up {p} -> {backup}")
    p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_suffix(f".tmp.{os.getpid()}")
    tmp.write_text(json.dumps(doc, indent=2) + "\n")
    os.replace(tmp, p)
    print(f"installed: {', '.join(added) or 'none'}"
          + (f"; refreshed: {', '.join(refreshed)}" if refreshed else ""))
    print("Restart your agent sessions for the hooks to load.")
    return RC_OK


def cmd_uninstall_hooks(args) -> int:
    p = settings_path()
    if not p.exists():
        print(f"{p} does not exist; nothing to remove")
        return RC_OK
    try:
        doc = json.loads(p.read_text())
    except ValueError:
        print(f"agentaware: {p} is not valid JSON; refusing to touch it", file=sys.stderr)
        return RC_ERROR
    removed = 0
    for event, groups in list((doc.get("hooks") or {}).items()):
        if not isinstance(groups, list):
            continue
        keep = [g for g in groups if not _is_ours(g)]
        removed += len(groups) - len(keep)
        if keep:
            doc["hooks"][event] = keep
        else:
            doc["hooks"].pop(event, None)
    if not doc.get("hooks"):
        doc.pop("hooks", None)
    backup = p.with_suffix(f".json.bak-{time.strftime('%Y%m%d-%H%M%S')}")
    shutil.copy2(p, backup)
    tmp = p.with_suffix(f".tmp.{os.getpid()}")
    tmp.write_text(json.dumps(doc, indent=2) + "\n")
    os.replace(tmp, p)
    print(f"removed {removed} hook entr{'y' if removed == 1 else 'ies'}; "
          f"backup at {backup}")
    return RC_OK


def cmd_doctor(args) -> int:
    """What actually works on this machine — measured, not assumed."""
    snap = snapshot()
    ok = True
    def row(label, good, detail):
        nonlocal ok
        ok = ok and good
        print(f"  {'ok  ' if good else 'FAIL'} {label:<28} {detail}")

    print(f"agentaware {VERSION} on {os.uname().sysname} ({os.uname().nodename})")
    print(f"\nregistry")
    row("runtime dir", os.access(runtime_dir(), os.W_OK), str(runtime_dir()))
    row("state dir", os.access(state_dir(), os.W_OK), str(state_dir()))
    print(f"\nresource signals")
    cg = user_cgroup()
    row("memory pressure", cg is not None,
        snap["pressure_source"] if cg else
        "no user cgroup — the gate falls back to MemAvailable only")
    row("oomd thresholds", snap["oomd"]["source"] != "default",
        f"kill at {snap['oomd']['pressure_pct']:.0f}% for {snap['oomd']['duration']}, "
        f"swap {snap['oomd']['swap_pct']:.0f}%  [{snap['oomd']['source']}]")
    row("MemAvailable", snap["mem_total"] > 0,
        f"{gb(snap['mem_available'])} of {gb(snap['mem_total'])}")
    io_deleg = "io" in _delegated()
    print(f"  {'ok  ' if io_deleg else 'note'} {'io control':<28} "
          + ("delegated" if io_deleg else
             "not delegated to this user slice — IO cannot be capped, only observed"))
    print(f"\nhooks")
    p = settings_path()
    installed = []
    try:
        doc = json.loads(p.read_text()) if p.exists() else {}
        for ev, groups in (doc.get("hooks") or {}).items():
            if isinstance(groups, list) and any(_is_ours(g) for g in groups):
                installed.append(ev)
    except (OSError, ValueError):
        pass
    row("settings.json", p.exists(), str(p))
    row("our hooks", len(installed) == len(HOOK_EVENTS),
        f"{len(installed)}/{len(HOOK_EVENTS)} installed"
        + (f" ({', '.join(sorted(set(HOOK_EVENTS) - set(installed)))} missing)"
           if installed and len(installed) < len(HOOK_EVENTS) else "")
        + ("  -> agentaware install-hooks" if len(installed) < len(HOOK_EVENTS) else ""))
    t0 = time.perf_counter()
    snapshot()
    print(f"\n  hook cost per call: {(time.perf_counter() - t0) * 1000:.1f} ms "
          f"(runs on every tool use; must stay well under the 5s timeout)")
    return RC_OK if ok else RC_ERROR


def _delegated() -> str:
    cg = user_cgroup()
    if not cg:
        return ""
    try:
        return (cg / "cgroup.controllers").read_text()
    except OSError:
        return ""


def main() -> int:
    p = argparse.ArgumentParser(
        prog="agentaware",
        description="What every agent session on this machine is doing, and whether "
                    "there is room to start something heavy.")
    p.add_argument("--version", action="version", version=VERSION)
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("board", help="one screen: who is doing what, and is there room")
    s.add_argument("--json", action="store_true"); s.set_defaults(fn=cmd_board)

    s = sub.add_parser("gate", help="may work of this class start right now?")
    s.add_argument("klass", metavar="CLASS", choices=sorted(CLASSES))
    s.set_defaults(fn=cmd_gate)

    s = sub.add_parser("run", help="wait for room, then run, holding a slot")
    s.add_argument("--class", dest="klass", required=True, choices=sorted(CLASSES))
    s.add_argument("--timeout", type=float, default=1800.0,
                   help="seconds to wait for a slot (default 1800)")
    s.add_argument("cmd", nargs=argparse.REMAINDER)
    s.set_defaults(fn=cmd_run)

    s = sub.add_parser("hook", help="hook entry point (installed into settings.json)")
    s.add_argument("event"); s.set_defaults(fn=cmd_hook)

    s = sub.add_parser("install-hooks", help="add our hooks, leaving others alone")
    s.add_argument("--dry-run", action="store_true"); s.set_defaults(fn=cmd_install_hooks)

    sub.add_parser("uninstall-hooks", help="remove only our hooks"
                   ).set_defaults(fn=cmd_uninstall_hooks)
    sub.add_parser("doctor", help="what works on this machine").set_defaults(fn=cmd_doctor)

    args = p.parse_args()
    if getattr(args, "fn", None) is cmd_run and args.cmd and args.cmd[0] == "--":
        args.cmd = args.cmd[1:]
    return args.fn(args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
